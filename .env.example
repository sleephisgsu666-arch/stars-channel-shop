# Generate secrets locally; never commit the filled .env.
BOT_TOKEN=
WEBHOOK_BASE_URL=https://shop.example.com
WEBHOOK_PATH=
WEBHOOK_SECRET=
DATABASE_URL=postgresql+asyncpg://shop_app:CHANGE_ME@postgres:5432/shop
MIGRATION_DATABASE_URL=postgresql+asyncpg://shop_migrator:CHANGE_ME@postgres:5432/shop
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
ADMIN_TELEGRAM_IDS=[123456789]
SUPPORT_CONTACT=@your_support
TERMS_URL=https://shop.example.com/terms
TERMS_TEXT=Цифровой доступ к закрытым каналам. Возвраты и помощь: /paysupport.
APP_ENV=production
LOG_LEVEL=INFO
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
REDIS_PASSWORD=
EXPIRE_INTERVAL=60
CLEANUP_INTERVAL=300
RECONCILIATION_INTERVAL=7200
INVITE_TTL=600
ORDER_TTL=1800
